# 이 파일은 "키 이름 목록"입니다. 실제 값은 .env 에 적고 .env 는 절대 커밋하지 않습니다.
# (에이전트는 .env 를 읽거나 쓸 수 없습니다. 값이 필요한 작업은 사람이 직접 채웁니다.)
# MYSQL_* 는 로컬 MySQL(compose.yaml)과 백엔드(application.yml)가 함께 읽는다.

# 공통
APP_ENV=local

# 데이터베이스 (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=13306
MYSQL_DATABASE=every_study
MYSQL_USER=
MYSQL_PASSWORD=

# JWT (서명 키는 32자 이상의 랜덤 값을 사람이 직접 생성해 .env 에만 둔다. 짧으면 백엔드가 기동하지 않는다)
JWT_SECRET=

# 소셜 로그인 (PRD 4.1: 카카오·구글). 발급 방법과 리다이렉트 URI 는 backend/README.md "소셜 로그인 준비"
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 로그인 뒤 돌아갈 프론트 주소 (비우면 http://localhost:3000)
FRONTEND_URL=http://localhost:3000
# 토큰 쿠키의 Secure 속성 (비우면 true). HTTPS 가 아닌 로컬에서 쿠키가 저장되지 않을 때만 false
AUTH_COOKIE_SECURE=true

# 프론트엔드가 바라보는 백엔드 주소
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
