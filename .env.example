# 이 파일은 "키 이름 목록"입니다. 실제 값은 .env 에 적고 .env 는 절대 커밋하지 않습니다.
# (에이전트는 .env 를 읽거나 쓸 수 없습니다. 값이 필요한 작업은 사람이 직접 채웁니다.)
# 기술 스택 확정(ARCHITECTURE.md) 후 키를 갱신하세요.

# 공통
APP_ENV=local

# 소셜 로그인 (PRD 4.1: 카카오·구글)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 프론트엔드가 바라보는 백엔드 주소
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
