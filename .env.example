# 이 파일은 "키 이름 목록"입니다. 실제 값은 .env 에 적고 .env 는 절대 커밋하지 않습니다.
# (에이전트는 .env 를 읽거나 쓸 수 없습니다. 값이 필요한 작업은 사람이 직접 채웁니다.)
# MYSQL_* 는 로컬 MySQL(compose.yaml)과 백엔드(application.yml)가 함께 읽는다.

# 공통
APP_ENV=local

# 데이터베이스 (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=13306
MYSQL_DATABASE=every_study
MYSQL_USER=
MYSQL_PASSWORD=

# JWT (서명 키는 32자 이상의 랜덤 값을 사람이 직접 생성해 .env 에만 둔다. 짧으면 백엔드가 기동하지 않는다)
JWT_SECRET=

# 소셜 로그인 (PRD 4.1: 카카오·구글). 발급 방법과 리다이렉트 URI 는 backend/README.md "소셜 로그인 준비"
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 로그인 뒤 돌아갈 프론트 주소 (비우면 http://localhost:3000)
FRONTEND_URL=http://localhost:3000
# 토큰 쿠키의 Secure 속성 (비우면 true). HTTPS 가 아닌 로컬에서 쿠키가 저장되지 않을 때만 false
AUTH_COOKIE_SECURE=true
# 쿠키의 Domain. 로컬은 비운다. 배포에서는 deploy/compose.yaml 이 APP_DOMAIN 으로 채운다
AUTH_COOKIE_DOMAIN=

# 프론트엔드가 바라보는 백엔드 주소
NEXT_PUBLIC_API_BASE_URL=http://localhost:8090

# 카카오맵 JavaScript 키 (PLAN H-2). 브라우저에 공개되는 키라 사이트 도메인을 제한한다.
# 카카오 개발자 콘솔: 앱 > 플랫폼 키 > JavaScript 키의 "JavaScript SDK 도메인"에 http://localhost:3000 을 등록하고, 제품 설정 > 카카오맵을 켠다.
# 지도를 불러오지 못하면 개발 서버에서는 장소 검색이 예시 장소를 준다. 값을 바꾸면 프론트 개발 서버를 다시 시작한다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# ── 운영 배포 (deploy/README.md). 서버의 배포 디렉토리에 둔 환경 파일에만 적는다. 로컬에서는 쓰지 않는다 ──
# 등록 도메인 (예: example.com). 프론트 https://app.<도메인>, API https://api.<도메인>
APP_DOMAIN=
# 인증서(Let's Encrypt) 만료 알림을 받을 메일 주소
ACME_EMAIL=
# (선택) 백엔드 JVM 힙 상한. 비우면 512m. 서버 메모리를 늘리면 함께 올린다
BACKEND_HEAP=
